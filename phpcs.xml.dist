<?xml version="1.0"?>
<ruleset name="Ashbi Subscriptions">
  <description>WordPress coding standards for maintained Ashbi code.</description>

  <file>plugin</file>
  <file>tools</file>
  <file>tests</file>

  <exclude-pattern>plugin/vendor/*</exclude-pattern>
  <exclude-pattern>plugin/build/*</exclude-pattern>
  <exclude-pattern>plugin/assets/js/chart.js</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>
  <arg value="ps"/>

  <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils"/>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Extra"/>

  <config name="minimum_supported_wp_version" value="6.2"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_woocommerce"/>
      </property>
    </properties>
  </rule>
</ruleset>
