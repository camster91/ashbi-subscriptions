{
  "name": "ashbi/subscriptions-development",
  "description": "Development and verification tooling for Ashbi Subscriptions.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^10.0 || ^11.0",
    "php-stubs/wordpress-stubs": "^6.8 || ^7.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "test": [
      "@test:contract",
      "@test:unit",
      "@test:package"
    ],
    "test:contract": "php tests/compatibility-contract.php",
    "test:unit": "phpunit",
    "test:package": "bash scripts/test-release-package.sh",
    "lint": [
      "@lint:syntax",
      "@lint:phpcs",
      "@lint:phpstan"
    ],
    "lint:syntax": "bash scripts/test-baseline.sh",
    "lint:phpcs": "phpcs",
    "lint:phpstan": "phpstan analyse --memory-limit=2G"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    },
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  }
}
